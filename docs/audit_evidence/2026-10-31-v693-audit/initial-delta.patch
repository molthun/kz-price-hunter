+def _zero_out_residual_bytes(db_path: pathlib.Path, residual_bytes_list: list) -> None:
+    for target in (db_path, pathlib.Path(str(db_path) + "-wal")):
+        if not target.exists():
+            continue
+        try:
+            with open(target, "r+b") as f:
+                content = f.read()
+                modified = False
+                for b in residual_bytes_list:
+                    if not b or len(b) < 3:
+                        continue
+                    if b in content:
+                        content = content.replace(b, b"\x00" * len(b))
+                        modified = True
+                if modified:
+                    f.seek(0)
+                    f.write(content)
+                    f.flush()
+        except OSError:
+            pass
+
