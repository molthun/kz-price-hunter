+            c.channel_type,
+            c.name AS channel_name,
+            o.condition,
+            o.city,
+            o.currency,
+            oph.price,
+            oph.old_price,
+            oph.observed_at
+        FROM offer_price_history oph
+        JOIN offers o ON o.id = oph.offer_id
+        LEFT JOIN sellers s ON s.id = o.seller_id
