# Окружение прода на машине стенда. Скопировать в ~/kzph-prod/.env и заполнить ТЕМИ ЖЕ
# значениями, что на NAS (/volume1/docker/kz-price-hunter: часть лежит в .env, часть — прямо
# в compose.yaml). Сам .env в git не попадает. Права: chmod 600 .env
#
#   cp prod.env.example .env && chmod 600 .env

# Адрес сайта: ссылки в интерфейсе и уведомлениях, ожидаемый Origin для POST и Secure-cookie
APP_URL=https://shop.molthun.ru
PUBLIC_ORIGIN=https://shop.molthun.ru

# Сосед, которого видит aiohttp. После переезда это сам NAS — обратный прокси DSM приходит
# по локальной сети с 192.168.28.10 (так уже работает стенд shdev.molthun.ru).
# На NAS было 172.26.0.1/16 — это адрес моста Docker на самом NAS, здесь он неверен.
# Проверить после переключения: ./verify_public.sh («Соседи порта» — 192.168.28.10).
TRUSTED_PROXIES=192.168.28.10/32

# Токен ПРОДОВОГО бота. Telegram допускает одного потребителя getUpdates: пока он задан
# здесь, контейнер на NAS обязан быть остановлен (иначе HTTP 409 и сломанный бот у обоих).
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Токен диагностики /diag и /api/diag. Можно перенести с NAS или сгенерировать: openssl rand -hex 24
DIAG_TOKEN=

# Ключи AI, если заданы на NAS в окружении (обычно они хранятся в настройках в базе — тогда пусто)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Необязательное: по умолчанию 4 потока на ядро в границах 8..32; при cpus: 8 выйдет 32
WORKER_THREADS=
