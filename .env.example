# Deployment example. No credentials are included; replace example values with your own.
APP_URL=https://shop.example.kz
PUBLIC_ORIGIN=https://shop.example.kz
ALLOW_DEV_LOGIN=0

# Empty = ignore forwarded headers. Before deployment, determine the immediate
# peer seen by aiohttp through the reverse proxy/Docker bridge, then use that exact IP/32.
# The host LAN address and the public NAT address do NOT prove that peer.
# Do not trust 0.0.0.0/0, all private networks, or a guessed Docker gateway.
TRUSTED_PROXIES=

# Fill locally. Do not commit the resulting .env or paste values into reports.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# /search card as a Telegram HTML widget (Bot API 10.4) pilot: off (default) | admins | all.
TELEGRAM_SEARCH_WIDGET=off
# /watches card as a Telegram HTML widget (Bot API 10.4, TG-07): off (default) | admins | all.
TELEGRAM_WATCHES_WIDGET=off
# Buttons that lead to this site: webapp (default, opens as a Mini App with auto-login over https) | url.
TELEGRAM_SITE_BUTTONS=webapp
# Edit an already sent deal alert when its price went back up or the item is gone: off (default) | on.
TELEGRAM_STALE_MARK=off
# Skip users who blocked the bot (my_chat_member updates and 403 on send): on (default) | off.
TELEGRAM_BLOCK_TRACKING=on
# AI consultant progress as a message draft with a Stop button (sendMessageDraft): off (default) | admins | all.
TELEGRAM_AI_DRAFTS=off
# Bot menu, applied at bot start: off (default, menu untouched) | commands | webapp.
# webapp: the menu button opens a site section as a Mini App (the Main App already opens the home page).
TELEGRAM_MENU_BUTTON=off
TELEGRAM_MENU_BUTTON_PATH=/deals
TELEGRAM_MENU_BUTTON_TEXT=Скидки
# Button styles (primary/danger/success, Bot API 9.4, TG-08): on (default) | off.
TELEGRAM_BUTTON_STYLES=on
# One-tap copy button (copy_text, Bot API 7.11, TG-08): on (default) | off.
TELEGRAM_COPY_BUTTON=on
# Rich Messages with native Markdown tables (sendRichMessage, Bot API 10.1+, TG-03): on (default) | off.
TELEGRAM_RICH_MESSAGES=on
# Native user-local time formatting via <tg-time> (Bot API 9.5, TG-13): on (default) | off.
TELEGRAM_NATIVE_TIME=on
# Existing AI credentials remain in the admin settings; this example does not replace them.
