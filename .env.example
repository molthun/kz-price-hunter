# Deployment example. No credentials are included; replace example values with your own.
APP_URL=https://shop.example.kz
PUBLIC_ORIGIN=https://shop.example.kz
ALLOW_DEV_LOGIN=0

# Empty = ignore forwarded headers. Before deployment, determine the immediate
# peer seen by aiohttp through the reverse proxy/Docker bridge, then use that exact IP/32.
# The host LAN address and the public NAT address do NOT prove that peer.
# Do not trust 0.0.0.0/0, all private networks, or a guessed Docker gateway.
TRUSTED_PROXIES=

# Fill locally. Do not commit the resulting .env or paste values into reports.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# /search card as a Telegram HTML widget (Bot API 10.4) pilot: off (default) | admins | all.
TELEGRAM_SEARCH_WIDGET=off
# Bot menu, applied at bot start: off (default, menu untouched) | commands | webapp.
# webapp: the menu button opens a site section as a Mini App (the Main App already opens the home page).
TELEGRAM_MENU_BUTTON=off
TELEGRAM_MENU_BUTTON_PATH=/deals
TELEGRAM_MENU_BUTTON_TEXT=Скидки
# Existing AI credentials remain in the admin settings; this example does not replace them.
