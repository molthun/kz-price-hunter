# Deployment example for the owner's Synology. No credentials are included.
APP_URL=https://shop.molthun.ru
PUBLIC_ORIGIN=https://shop.molthun.ru
ALLOW_DEV_LOGIN=0

# Empty = ignore forwarded headers. Before deployment, determine the immediate
# peer seen by aiohttp through Synology/Docker bridge, then use that exact IP/32.
# Synology LAN 192.168.28.10 and public NAT 93.170.212.215 do NOT prove that peer.
# Do not trust 0.0.0.0/0, all private networks, or a guessed Docker gateway.
TRUSTED_PROXIES=

# Fill locally. Do not commit the resulting .env or paste values into reports.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# Existing AI credentials remain in the admin settings; this example does not replace them.
