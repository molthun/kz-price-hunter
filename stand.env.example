# Окружение испытательного стенда. Скопировать в .env рядом с docker-compose.stand.yml
# и заполнить. Сам .env в git не попадает.
#
#   cp stand.env.example .env

# Адрес стенда в локальной сети. Нужен для ссылок в интерфейсе и в уведомлениях.
APP_URL=http://192.168.28.25:35539
PUBLIC_ORIGIN=http://192.168.28.25:35539

# Пусто — заголовки X-Forwarded-* не считаются доверенными. Заполнять только если перед
# стендом появится обратный прокси, и тогда вписать адрес именно того соседа, которого
# видит aiohttp, а не адрес машины в сети.
TRUSTED_PROXIES=

# Обход входа через Telegram. Ноль — как на проде. Единица упрощает проверки интерфейса,
# но тогда стенд не должен быть доступен никому, кроме вас.
ALLOW_DEV_LOGIN=0

# ВАЖНО: это НЕ токен продового бота.
# Telegram допускает только одного потребителя getUpdates: второй экземпляр с тем же
# токеном сломает бота на проде — в логах это видно как «Конфликт polling/webhook (HTTP 409)».
# Либо отдельный тестовый бот, либо оставить пустым: без токена приложение работает,
# отключены только вход через Telegram и уведомления.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Токен диагностики. Сгенерировать: openssl rand -hex 24
# На стенде она заработает сразу — код там свежий, в отличие от прода.
DIAG_TOKEN=

# Необязательное. Пусто — приложение считает размер пула само: 4 потока на ядро,
# границы 8..32. При лимите в 4 ядра получится 16. Задавать явно имеет смысл только
# чтобы сравнить разные размеры замером, а не рассуждением.
WORKER_THREADS=
